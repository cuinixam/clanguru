{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push.sh\"",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}

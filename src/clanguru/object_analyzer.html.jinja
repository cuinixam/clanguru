<!DOCTYPE html>

<head>
    <meta charset="utf-8">
    <script>
        var MY_GRAPH_DATA = {{ graph_data | tojson(indent = 4) }};
    </script>
    {% raw %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.23.0/cytoscape.min.js"></script>
    <script src="https://unpkg.com/webcola@3.4.0/WebCola/cola.min.js"></script>
    <script src="https://unpkg.com/cytoscape-cola@2.5.1/cytoscape-cola.js"></script>
    <style>
        body {
            font-family: helvetica neue, helvetica, liberation sans, arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        #main-container {
            position: relative;
            flex-grow: 1;
            height: 100%;
        }

        #search-container {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.9);
            padding: 10px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

        #search-input {
            padding: 5px 10px;
            border: 1px solid #ccc;
            border-radius: 3px;
            font-size: 14px;
            width: 200px;
        }

        #search-results {
            max-height: 200px;
            overflow-y: auto;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 3px;
            background: white;
            display: none;
        }

        .search-result-item {
            padding: 5px 10px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

        .search-result-item:hover {
            background-color: #f0f0f0;
        }

        .search-result-item:last-child {
            border-bottom: none;
        }

        #clear-search, #reset-zoom {
            margin-left: 5px;
            padding: 5px 10px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
        }

        #clear-search:hover, #reset-zoom:hover {
            background: #0056b3;
        }

        #cy {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Filter Panel Styles */
        #filter-panel {
            width: 300px;
            background: #f8f9fa;
            border-left: 1px solid #ddd;
            display: flex;
            flex-direction: column;
            z-index: 2;
            box-shadow: -2px 0 5px rgba(0,0,0,0.05);
        }

        #filter-header {
            padding: 15px;
            background: #e9ecef;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #filter-header h2 {
            margin: 0;
            font-size: 14px;
            color: #333;
        }

        #filter-content {
            flex-grow: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .tree-node {
            margin-left: 20px;
        }

        /* Root nodes don't need margin */
        #tree-root > .tree-node {
            margin-left: 0;
        }

        .node-content {
            display: flex;
            align-items: center;
            padding: 2px 0;
        }

        .node-content:hover {
            background-color: #e2e6ea;
            border-radius: 3px;
        }

        .toggle-btn {
            cursor: pointer;
            width: 16px;
            height: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 5px;
            color: #6c757d;
            font-weight: bold;
            user-select: none;
        }

        .toggle-btn:hover {
            color: #333;
        }

        .checkbox {
            margin-right: 8px;
            cursor: pointer;
        }

        .node-label {
            cursor: pointer;
            user-select: none;
            color: #333;
        }

        .hidden {
            display: none;
        }

        #filter-controls {
            padding: 10px;
            border-top: 1px solid #ddd;
            display: flex;
            gap: 10px;
        }

        .control-btn {
            flex: 1;
            padding: 5px;
            font-size: 11px;
            cursor: pointer;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: 3px;
        }

        .control-btn:hover {
            background: #f1f3f5;
        }

        h1 {
            font-size: 1em;
            font-weight: bold;
        }

        .tree-highlight {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            border-radius: 3px;
            transition: background-color 0.5s;
        }

        /* Help Modal Styles */
        .modal {
            display: none; 
            position: fixed; 
            z-index: 2000; 
            left: 0;
            top: 0;
            width: 100%; 
            height: 100%; 
            overflow: auto; 
            background-color: rgba(0,0,0,0.4); 
        }

        .modal-content {
            background-color: #fefefe;
            margin: 10% auto; 
            padding: 20px;
            border: 1px solid #888;
            width: 80%; 
            max-width: 600px;
            border-radius: 5px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            font-size: 14px;
            line-height: 1.6;
        }

        .close-modal {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .close-modal:hover,
        .close-modal:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

        .help-section {
            margin-bottom: 20px;
        }

        .help-section h3 {
            margin-top: 0;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
        }
        
        #help-btn {
            margin-left: 5px;
            padding: 5px 10px;
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }

        #help-btn:hover {
            background: #5a6268;
        }
    </style>
</head>

<body>
    <div id="main-container">
        <div id="search-container">
            <input type="text" id="search-input" placeholder="Search nodes by name..." />
            <button id="clear-search">Clear</button>
            <button id="reset-zoom">Reset Zoom</button>
            <button id="help-btn" title="Help / Usage Guide">?</button>
            <div id="search-results"></div>
        </div>
        <div id="cy"></div>
    </div>

    <div id="filter-panel">
        <div id="filter-header">
            <h2>Directory Filter</h2>
        </div>
        <div id="filter-controls">
            <button class="control-btn" id="expand-all">Expand All</button>
            <button class="control-btn" id="collapse-all">Collapse All</button>
            <button class="control-btn" id="check-all">Check All</button>
            <button class="control-btn" id="uncheck-all">Uncheck All</button>
        </div>
        <div id="filter-content">
            <div id="tree-root"></div>
        </div>
    </div>

    <!-- Help Modal -->
    <div id="help-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2>Object Analyzer Help</h2>
            
            <div class="help-section">
                <h3>🔍 Search</h3>
                <p>Type in the search box to find specific nodes. Click a result to zoom and center on it.</p>
            </div>

            <div class="help-section">
                <h3>👆 Interaction</h3>
                <ul>
                    <li><strong>Select Edge:</strong> Click an edge to highlight it and its connected (source/target) nodes.</li>
                    <li><strong>Select Node:</strong> Click a node to see a red border and highlight its immediate neighbors.</li>
                    <li><strong>Double-Click Node:</strong> Finds the node (or its parent folder) in the <em>Directory Filter</em> tree on the right, expands the tree, and highlights the folder.</li>
                    <li><strong>Clear Selection:</strong> Click on the background canvas.</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>📁 Directory Filter</h3>
                <p>Use the panel on the right to toggle visibility of files and folders.</p>
                <ul>
                    <li><strong>Checkboxes:</strong> Hide/Show specific directories and their contents.</li>
                    <li><strong>Buttons:</strong> Use "Expand All", "Collapse All", etc., to manage the tree view.</li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // console.log(JSON.stringify(MY_GRAPH_DATA));

            // Initialize Cytoscape
            var cy = window.cy = cytoscape({
                container: document.getElementById('cy'),
                autounselectify: false,
                boxSelectionEnabled: false,
                layout: {
                    name: 'cola'
                },
                style: [
                    {
                        selector: 'node',
                        css: {
                            'label': 'data(label)',
                            'color': 'black',
                            'width': 'data(size)',
                            'height': 'data(size)',
                            'background-color': 'blue',
                            'text-halign': 'center',
                            'text-valign': 'top',
                            'font-size': 'data(font_size)',
                            'content': 'data(content)'
                        }
                    },
                    {
                        selector: 'node.highlighted',
                        css: {
                            'background-color': '#ff6b6b',
                            'border-width': 3,
                            'border-color': '#ff0000',
                            'color': 'white'
                        }
                    },
                    {
                        selector: 'node:selected',
                        css: {
                            'border-width': 4,
                            'border-color': '#ff0000',
                        }
                    },
                    {
                        css: {
                            'background-color': '#cccccc',
                            'background-opacity': 0.4,
                            'border-opacity': 0.4,
                            'color': '#555555',
                            'text-opacity': 1,
                            'opacity': 1
                        }
                    },
                    {
                        selector: 'node.filtered-out',
                        css: {
                            'display': 'none'
                        }
                    },
                    {
                        selector: 'node:parent',
                        css: {
                            'label': 'data(label)',
                            'background-opacity': 0.1
                        }
                    },
                    {
                        selector: 'edge',
                        css: {
                            'width': 1,
                        }
                    },
                    {
                        selector: 'edge.highlighted',
                        css: {
                            'width': 1,
                            'line-color': '#ff6b6b',
                            'target-arrow-color': '#ff6b6b',
                            'source-arrow-color': '#ff6b6b',
                            'opacity': 1
                        }
                    },
                    {
                        selector: 'edge.neighbor-highlight',
                        css: {
                            'line-color': '#ff6b6b',
                            'target-arrow-color': '#ff6b6b',
                            'source-arrow-color': '#ff6b6b',
                            'width': 4,
                            'opacity': 1
                        }
                    },
                    {
                        selector: 'edge.dimmed',
                        css: {
                            'opacity': 0.2
                        }
                    },
                    {
                        selector: 'edge.filtered-out',
                        css: {
                            'display': 'none'
                        }
                    },
                    {
                        selector: 'edge:selected',
                        css: {
                            'line-color': '#ff6b6b',
                            'target-arrow-color': '#ff6b6b',
                            'source-arrow-color': '#ff6b6b',
                            'width': 4,
                            'opacity': 1
                        }
                    },
                    {
                        selector: 'node.neighbor-highlight',
                        css: {
                            'background-color': '#ff6b6b',
                            'border-width': 3,
                            'border-color': '#ff0000',
                            'color': 'white'
                        }
                    }
                ],
                elements: MY_GRAPH_DATA,
                zoomingEnabled: true
            });

            // ---------------------------------------------------------
            // Edge Selection Logic
            // ---------------------------------------------------------
            cy.on('select', 'edge', function(e) {
                const edge = e.target;
                edge.connectedNodes().addClass('neighbor-highlight');
            });

            cy.on('unselect', 'edge', function(e) {
                const edge = e.target;
                edge.connectedNodes().removeClass('neighbor-highlight');
            });

            cy.on('select', 'node', function(e) {
                const node = e.target;
                node.neighborhood().addClass('neighbor-highlight');
            });

            cy.on('unselect', 'node', function(e) {
                const node = e.target;
                node.neighborhood().removeClass('neighbor-highlight');
            });

            // Double click to find in tree
            cy.on('dblclick', 'node', function(e) {
                const node = e.target;
                let targetId = node.id();

                // Find the corresponding checkbox in the tree
                // Strategy: 
                // 1. Try to find the node itself (it might be a directory)
                // 2. If not found, check if it has a parent in the graph (it might be a file inside a dir)
                // 3. Fallback to manually checking parent field from data if Cytoscape parent() not set yet (unlikely)

                let checkbox = document.querySelector(`.checkbox[data-node-id="${CSS.escape(targetId)}"]`);

                if (!checkbox) {
                    const parent = node.parent();
                    if (parent.nonempty()) {
                        targetId = parent.id();
                        checkbox = document.querySelector(`.checkbox[data-node-id="${CSS.escape(targetId)}"]`);
                    }
                }

                if (checkbox) {
                    // 1. Expand all parents
                    let parent = checkbox.closest('.tree-children');
                    while (parent) {
                        parent.style.display = 'block';
                        // Update the toggle button for this container
                        // The toggle button is in the sibling .node-content of the parent .tree-node
                        const treeNode = parent.closest('.tree-node');
                        if (treeNode) {
                            const nodeContent = treeNode.querySelector('.node-content');
                            if (nodeContent) {
                                const toggleBtn = nodeContent.querySelector('.toggle-btn');
                                if (toggleBtn && toggleBtn.innerText === '▶') {
                                    toggleBtn.innerText = '▼';
                                }
                            }
                        }
                        parent = parent.parentElement.closest('.tree-children');
                    }

                    // 2. Highlight text
                    // Remove existing highlights
                    document.querySelectorAll('.tree-highlight').forEach(el => el.classList.remove('tree-highlight'));
                    
                    const nodeContent = checkbox.closest('.node-content');
                    if (nodeContent) {
                        nodeContent.classList.add('tree-highlight');
                        
                        // 3. Scroll into view
                        nodeContent.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });

            // ---------------------------------------------------------
            // Filter Tree Logic
            // ---------------------------------------------------------
            const treeRoot = document.getElementById('tree-root');
            const hiddenNodeIds = new Set();

            // Build the filter tree
            function buildFilterTree(nodes, container) {
                if (!nodes || nodes.length === 0) return;

                const ul = document.createElement('div');
                ul.className = 'tree-level';

                nodes.forEach(node => {
                    const nodeWrapper = document.createElement('div');
                    nodeWrapper.className = 'tree-node';

                    const content = document.createElement('div');
                    content.className = 'node-content';

                    // Toggle button (chevron)
                    const toggleBtn = document.createElement('span');
                    toggleBtn.className = 'toggle-btn';
                    toggleBtn.innerHTML = node.children && node.children.length > 0 ? '▶' : ''; // Collapsed by default

                    // Checkbox
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.className = 'checkbox';
                    checkbox.checked = true;
                    checkbox.dataset.nodeId = node.id;
                    checkbox.dataset.nodeName = node.name;

                    // Label
                    const label = document.createElement('span');
                    label.className = 'node-label';
                    label.textContent = node.name;

                    content.appendChild(toggleBtn);
                    content.appendChild(checkbox);
                    content.appendChild(label);
                    nodeWrapper.appendChild(content);

                    // Children container
                    const childrenContainer = document.createElement('div');
                    childrenContainer.className = 'tree-children';
                    childrenContainer.style.display = 'none'; // Default collapsed

                    if (node.children && node.children.length > 0) {
                        buildFilterTree(node.children, childrenContainer);

                        // Toggle collapse/expand
                        const toggleHandler = (e) => {
                            e.stopPropagation();
                            if (childrenContainer.style.display === 'none') {
                                childrenContainer.style.display = 'block';
                                toggleBtn.innerHTML = '▼';
                            } else {
                                childrenContainer.style.display = 'none';
                                toggleBtn.innerHTML = '▶';
                            }
                        };
                        toggleBtn.addEventListener('click', toggleHandler);
                    }

                    nodeWrapper.appendChild(childrenContainer);
                    container.appendChild(nodeWrapper);

                     // Checkbox handler
                    checkbox.addEventListener('change', function(e) {
                         // Propagate to all children checkboxes in DOM
                         // Only propagate if this was a user interaction (which 'change' implies)
                         const childCheckboxes = childrenContainer.querySelectorAll('input[type="checkbox"]');
                         childCheckboxes.forEach(cb => {
                             cb.checked = checkbox.checked;
                         });

                         // If checked, ensure all ancestors are also checked
                         if (checkbox.checked) {
                             checkAncestors(checkbox);
                         }

                         updateGraphVisibility();
                    });
                });

                container.appendChild(ul);
            }

            // Function to check ancestor checkboxes recursively
            function checkAncestors(checkbox) {
                // hierarchy: input -> div.node-content -> div.tree-node -> div.tree-children -> div.tree-node(parent)
                const currentTreeNode = checkbox.closest('.tree-node');
                if (!currentTreeNode) return;

                const parentContainer = currentTreeNode.closest('.tree-children');
                if (!parentContainer) return; // Root level

                const parentTreeNode = parentContainer.closest('.tree-node');
                if (!parentTreeNode) return;

                const parentContent = parentTreeNode.querySelector('.node-content');
                if (!parentContent) return;

                const parentCheckbox = parentContent.querySelector('.checkbox');
                if (parentCheckbox && !parentCheckbox.checked) {
                    parentCheckbox.checked = true;
                    checkAncestors(parentCheckbox);
                }
            }

            if (MY_GRAPH_DATA.tree) {
                buildFilterTree(MY_GRAPH_DATA.tree, treeRoot);
            }

            // Debounce function for performance
            function debounce(func, wait) {
                let timeout;
                return function() {
                    const context = this, args = arguments;
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(context, args), wait);
                };
            }

            const updateGraphVisibility = debounce(function() {
                // 1. Collect all unchecked directory IDs (from the tree)
                // We'll traverse the DOM tree actually, since it maps 1:1 to structure
                // But simpler: just get all unchecked checkboxes and find their corresponding graph nodes

                const allCheckboxes = document.querySelectorAll('.checkbox');
                const uncheckedIds = new Set();
                const checkedIds = new Set();

                allCheckboxes.forEach(cb => {
                    const id = cb.dataset.nodeId;
                    if (!cb.checked) {
                        uncheckedIds.add(id);
                    } else {
                        checkedIds.add(id);
                    }
                });

                cy.batch(() => {
                    // Reset all first
                    cy.elements().removeClass('filtered-out');

                    // Logic:
                    // A node in the graph (file or dir) matches a tree node by ID (relative path).
                    // Also, file nodes are children of directory nodes in the graph (parent field).

                    // 1. Hide directory nodes that are explicitly unchecked
                    uncheckedIds.forEach(dirId => {
                         // Find the node in Cytoscape
                         const node = cy.getElementById(dirId);
                         if (node.nonempty()) {
                             node.addClass('filtered-out');
                             // Also hide all descendants (children, grandchildren, etc.)
                             node.descendants().addClass('filtered-out');
                         }
                    });

                    // 2. Hide edges connected to hidden nodes automatically happens visually if nodes are hidden?
                    // Cytoscape doesn't auto-hide edges if nodes are hidden via class/css usually.
                    // Actually, modifying 'display: none' on node hides connected edges too in Cytoscape.

                    // However, we might have edges explicitly between visible nodes that we want to keep.
                    // If a node is 'filtered-out', its edges are naturally hidden.
                    // So we mostly just need to target the nodes correctly.
                });
            }, 100);

            // Filter Controls
            document.getElementById('expand-all').addEventListener('click', () => {
                document.querySelectorAll('.tree-children').forEach(el => el.style.display = 'block');
                document.querySelectorAll('.toggle-btn').forEach(btn => {
                    if (btn.innerText) btn.innerText = '▼';
                });
            });

            document.getElementById('collapse-all').addEventListener('click', () => {
                document.querySelectorAll('.tree-children').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.toggle-btn').forEach(btn => {
                    if (btn.innerText) btn.innerText = '▶';
                });
            });

            document.getElementById('check-all').addEventListener('click', () => {
                 document.querySelectorAll('.checkbox').forEach(cb => cb.checked = true);
                 updateGraphVisibility();
            });

            document.getElementById('uncheck-all').addEventListener('click', () => {
                 document.querySelectorAll('.checkbox').forEach(cb => cb.checked = false);
                 updateGraphVisibility();
            });

            // ---------------------------------------------------------
            // Existing Search functionality (kept as is)
            // ---------------------------------------------------------
            const searchInput = document.getElementById('search-input');
            const searchResults = document.getElementById('search-results');
            const clearButton = document.getElementById('clear-search');
            const resetZoomButton = document.getElementById('reset-zoom');
            let currentMatches = [];

            function getAllNodes() {
                // Return only visible nodes for search? Or all?
                // Let's filter by validity first
                return cy.nodes().filter(function(node) {
                    return !node.isParent() && !node.hasClass('filtered-out'); // Search only visible leaf nodes
                });
            }

            function searchNodes(query) {
                if (!query || query.trim() === '') {
                    return [];
                }

                const lowerQuery = query.toLowerCase();
                return getAllNodes().filter(function(node) {
                    const label = node.data('label') || '';
                    const content = node.data('content') || '';
                    const id = node.data('id') || '';

                    return label.toLowerCase().includes(lowerQuery) ||
                           content.toLowerCase().includes(lowerQuery) ||
                           id.toLowerCase().includes(lowerQuery);
                });
            }

            function highlightNodes(nodes) {
                // Clear previous highlights
                cy.nodes().removeClass('highlighted dimmed');
                cy.edges().removeClass('highlighted dimmed');

                if (nodes.length === 0) {
                    return;
                }

                // Highlight matching nodes
                nodes.addClass('highlighted');

                // Get all edges connected to the highlighted nodes
                const connectedEdges = nodes.connectedEdges().filter(e => !e.hasClass('filtered-out'));
                connectedEdges.addClass('highlighted');

                // Dim non-matching nodes and edges
                // Only consider visible nodes
                const visibleNodes = cy.nodes().not('.filtered-out');
                visibleNodes.difference(nodes).addClass('dimmed');

                const visibleEdges = cy.edges().not('.filtered-out');
                visibleEdges.difference(connectedEdges).addClass('dimmed');

                // Center on first match if there are results
                if (nodes.length > 0) {
                    cy.center(nodes[0]);
                    cy.zoom(1.5);
                }
            }

            function clearSearch() {
                searchInput.value = '';
                searchResults.style.display = 'none';
                cy.nodes().removeClass('highlighted dimmed');
                cy.edges().removeClass('highlighted dimmed');
                // Fit only visible nodes (edges might not be marked filtered-out but are hidden if nodes are)
                cy.fit(cy.nodes().not('.filtered-out'));
                currentMatches = [];
            }


            function updateSearchResults(matches) {
                searchResults.innerHTML = '';

                if (matches.length === 0) {
                    searchResults.style.display = 'none';
                    return;
                }

                searchResults.style.display = 'block';

                matches.forEach(function(node, index) {
                    const item = document.createElement('div');
                    item.className = 'search-result-item';
                    item.textContent = node.data('label') || node.data('id') || 'Unnamed';

                    item.addEventListener('click', function() {
                        cy.center(node);
                        cy.zoom(2);
                        searchResults.style.display = 'none';
                    });

                    searchResults.appendChild(item);
                });
            }

            searchInput.addEventListener('input', function() {
                const query = this.value;
                currentMatches = searchNodes(query);
                highlightNodes(currentMatches);
                updateSearchResults(currentMatches);
            });

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    clearSearch();
                }
            });

            clearButton.addEventListener('click', clearSearch);

            resetZoomButton.addEventListener('click', function() {
                cy.fit(cy.nodes().not('.filtered-out'));
            });

            // Hide search results when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#search-container')) {
                    searchResults.style.display = 'none';
                }
            });

            // ---------------------------------------------------------
            // Help Modal Logic
            // ---------------------------------------------------------
            const modal = document.getElementById("help-modal");
            const btn = document.getElementById("help-btn");
            const span = document.getElementsByClassName("close-modal")[0];

            btn.onclick = function() {
                modal.style.display = "block";
            }

            span.onclick = function() {
                modal.style.display = "none";
            }

            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = "none";
                }
            }
        });
    </script>
</body>

</html>

